# Who writes verdicts (and classifies leftover headlines): claude | openai
LLM_PROVIDER=claude
# claude: Claude Agent SDK on your Claude login (run `claude`, then /login) or a token
# from `claude setup-token` in CLAUDE_CODE_OAUTH_TOKEN. No API key.
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Claude Code processes answering side by side
CLAUDE_POOL=4
# openai: LangChain + an OpenAI API key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to 1 to send leftover ("maybe") headlines to the LLM for keep/drop.
SMA_LLM_NEWS_CLASSIFIER=0
# Optional: move run folders / caches off the repo (defaults: ./output, ./data/cache)
# SDA_OUTPUT_DIR=
# SDA_CACHE_DIR=
# Optional LangSmith tracing (openai provider only)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
